# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is validated in src/lib/env.ts.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. For local development run `pnpm db:start`, then `pnpm db:status`
# and copy the values it prints (API URL, Publishable key, Secret key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses Row Level Security: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional demo account for the "Continue as demo user" button.
# Locally, supabase/seed.sql creates it with exactly these credentials.
DEMO_USER_EMAIL=demo@konnect.dev
DEMO_USER_PASSWORD=konnect-demo-2026
